# Set this in the existing .env alongside your Shelfarr Compose file.
# Use a certificate trusted by the Shelfarr container. Include the URL prefix if applicable.
JELLYFIN_AUTH_URL=https://jellyfin.example.net

# For a trusted private Docker network, use the Jellyfin service name:
# JELLYFIN_AUTH_URL=http://jellyfin:8096
# JELLYFIN_ALLOW_PRIVATE_HTTP=true

# Set a tested image tag if your Compose file uses SHELFARR_VERSION.
# SHELFARR_VERSION=2026.11.16.1
